{
  "comments": {
    "lineComment": "#"
  },
  "completionTriggerCharacters": [".", "\"", "(", ","],
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*.*:\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:elif\\b|else\\b|while\\b.*)$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*.*:\\s*(?:#.*)?$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*(?:elif\\b|else\\b).*$",
      "action": {
        "indent": "outdent"
      }
    }
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^`~!@$^&*()=+\\[{\\]}\\\\|;:'\",.<>/?\\s]+)"
}
