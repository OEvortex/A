fn main() -> void:
    var a = 12
    var b = 10
    print(a & b)
    print(a | b)
    print(a ^ b)
    print(~a)
    print(a << 2)
    print(a >> 1)
    var x = 0b0110
    x &= 3
    print(x)
    x |= 8
    print(x)
    x ^= 1
    print(x)
    x <<= 2
    print(x)
    x >>= 1
    print(x)
    print(5 & 3 | 8)
main()
