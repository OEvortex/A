var xs = [3, 1, 2]
xs.append(4)
print("append:", xs)
xs.extend([5, 6])
print("extend:", xs)
xs.insert(0, 0)
xs.insert(-1, 99)
xs.insert(100, 100)
print("insert:", xs)
print("count:", xs.count(1))
print("index:", xs.index(2), "ranged:", xs.index(1, 2))
var ys = xs.copy()
ys.clear()
print("copy:", xs, "cleared:", ys)
print("pop:", xs.pop(), "pop0:", xs.pop(0), "left:", xs)
xs.remove(99)
print("remove:", xs)
xs.reverse()
print("reverse:", xs)
var words = ["pear", "apple", "fig"]
words.sort()
print("sort:", words)
xs.extend(xs)
print("self extend:", xs)
