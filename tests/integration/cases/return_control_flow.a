fn classify(n: i64) -> i64:
    defer print("leaving {n}")
    for i in 0..10:
        if i == n:
            return i * 2
    return -1

fn first_negative(values: [i64]) -> i64:
    var index = 0
    while index < len(values):
        if values[index] < 0:
            return values[index]
        index += 1
    return 0

fn nested(limit: i64) -> i64:
    var total = 0
    for i in 0..5:
        for j in 0..5:
            if i + j == limit:
                return total
            total += 1
    return total

fn main() -> void:
    print(classify(3))
    print(classify(15))

    numbers = [4, 7, -2, 9]
    print(first_negative(numbers))

    print(nested(4))
    print(nested(100))

main()
