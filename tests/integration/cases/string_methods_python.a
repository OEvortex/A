print("capitalize:", "hELLO wORLD".capitalize())
print("casefold:", "HÉLLO".casefold())
print("title:", "hello world".title())
print("swapcase:", "Hello World".swapcase())
print("center:", "ab".center(5, "-"), "|", "ab".center(4, "-"))
print("ljust:", "ab".ljust(5, "."), "rjust:", "ab".rjust(5, "."))
print("zfill:", "42".zfill(5), "-42".zfill(5), "+7".zfill(4))
print("count:", "banana".count("na"), "empty:", "abc".count(""))
print("find:", "banana".find("na", 3), "rfind:", "banana".rfind("na"))
print("index:", "banana".index("na"), "rindex:", "banana".rindex("na"))
print("startswith:", "hello".startswith("ell", 1), "endswith:", "hello".endswith("ell", 0, 4))
print("expandtabs:", "a\tb\tc".expandtabs(4))
print("strip:", "xxhelloxx".strip("x"), "lstrip:", "  hi  ".lstrip(), "rstrip:", "  hi  ".rstrip())
print("partition:", "a-b-c".partition("-"))
print("rpartition:", "a-b-c".rpartition("-"))
print("removeprefix:", "unhappy".removeprefix("un"), "removesuffix:", "happy.py".removesuffix(".py"))
print("replace:", "aaa".replace("a", "b", 2))
print("split:", "  a  b c  ".split(), "|", "a,b,c".split(",", 1))
print("rsplit:", "a,b,c".rsplit(",", 1))
print("splitlines:", "a\nb\r\nc".splitlines(), "keep:", "a\nb".splitlines(true))
print("join:", "-".join(["a", "b", "c"]))
print("isalnum:", "abc123".isalnum(), "isalpha:", "abc".isalpha(), "isascii:", "hé".isascii())
print("isdecimal:", "123".isdecimal(), "isdigit:", "123".isdigit(), "isnumeric:", "123".isnumeric())
print("isidentifier:", "foo_1".isidentifier(), "1foo".isidentifier())
print("islower:", "abc".islower(), "isupper:", "ABC".isupper(), "istitle:", "Hello World".istitle())
print("isprintable:", "hi".isprintable(), "isspace:", " \t\n".isspace())
print("utf8 find:", "héllo".find("l"), "count:", "héllo".count("l", 2))
print("contains:", "banana".contains("nan"), "repeat:", "ab".repeat(2))
print("chars:", "hé".chars())
