print("round:", round(2.5), round(-2.5), round(2.4))
print("trunc:", trunc(2.9), trunc(-2.9))
print("log2:", log2(8.0), "log10:", log10(1000.0))
print("atan2:", atan2(0.0, 1.0))
print("sqrt:", sqrt(16.0), "pow:", pow(2.0, 10.0))
print("abs:", abs(-7), abs(-2.5), "min:", min(3, 9), "max:", max(3.0, 9.0))

print("PI:", PI, "E:", E)
print("I32:", I32_MIN, I32_MAX)
print("U8:", U8_MAX, "U32:", U32_MAX)
print("F64 max:", F64_MAX > 0.0, "F64 min:", F64_MIN < 0.0)

r = random()
print("random in range:", r >= 0.0 and r < 1.0)
n = random_int(1, 6)
print("random_int in range:", n >= 1 and n <= 6)
print("floor/ceil:", floor(2.7), ceil(2.1))
