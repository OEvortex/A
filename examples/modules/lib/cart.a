import "money.a"
from "money.a" import Money

struct Cart:
    items: [String]
    total: Money

    fn add(self, name: String, price: Money) -> void:
        self.items.push(name)
        self.total = Money(self.total.cents + price.cents)

    fn render(self) -> void:
        print("Cart:")
        for item in self.items:
            print("  - " + item)
        print("  total: " + self.total.format())

fn empty() -> Cart:
    return Cart(items=[], total=money.Money(0))
