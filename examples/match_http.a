# Classifying HTTP responses with match expressions.

fn describe(status: i32) -> String:
    return match status:
        200 => "OK"
        201 => "Created"
        204 => "No content"
        301 => "Moved permanently"
        400..499 => "Client error"
        500..599 => "Server error"
        _ => "Unknown status"

fn category(status: i32) -> String:
    return match status:
        _ if status < 100 => "invalid"
        _ if status < 200 => "informational"
        _ if status < 300 => "success"
        _ if status < 400 => "redirect"
        _ if status < 500 => "client error"
        _ if status < 600 => "server error"
        _ => "invalid"

for code in [200, 301, 404, 503, 42]:
    print("{code}: {describe(code)} ({category(code)})")

method = "POST"
action = match method:
    "GET" => "read"
    "POST" => "create"
    "PUT" => "replace"
    "DELETE" => "remove"
    _ if len(method) > 0 => "unknown"
    _ => "missing"
print("method {method}: {action}")
